<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WAM-broker (msalruntime.dll) mee in de single-file exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Geen designer in gebruik: serialisatie-attributen op Form-properties zijn zinloos -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.0" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.90.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeetingAlarm.Tests" />
  </ItemGroup>

</Project>
